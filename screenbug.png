<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spacetoon Old Screenbug Loop (10s Hold)</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: transparent;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
        }

        /* Top-Right corner positioning */
        #logo-container {
            position: absolute;
            top: 35px;
            right: 45px; 
            width: 220px;
            height: auto;
            opacity: 0;
            transform-origin: center;
        }

        /* --- THE MASTER LOOP ANIMATION --- 
           Total Duration: 12 seconds
           0s - 0.8s: Intro / Flying in
           0.8s - 10.0s: Staying visible & perfect shining (10 seconds total hold!)
           10.0s - 11.0s: Moving letters / Disappearing transition
           11.0s - 12.0s: Hidden / Reset period
        */
        .looping-active {
            animation: spacetoonMasterLoop 12s ease-in-out infinite;
        }

        /* The image container holding your perfect right-to-left sheen */
        .bug-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            display: inline-block;
            overflow: hidden;
        }

        /* The 3D logo image */
        .bug-image {
            width: 100%;
            height: auto;
            display: block;
        }

        /* --- UNTOUCHED: Your Perfect Shine Effect --- */
        .bug-wrapper::after {
            content: '';
            position: absolute;
            top: 0;
            right: -150%; 
            width: 100%;
            height: 100%;
            background: linear-gradient(
                -90deg,
                transparent 0%,
                rgba(255, 255, 255, 0) 30%,
                rgba(255, 255, 255, 0.75) 50%,
                rgba(255, 255, 255, 0) 70%,
                transparent 100%
            );
            transform: skewX(25deg);
        }

        .shine-active::after {
            animation: logoShineRTL 1.2s ease-in-out infinite;
        }

        /* --- Keyframes --- */

        /* Master Animation Sequence adjusted for a 10-second hold */
        @keyframes spacetoonMasterLoop {
            /* 0% to 6.6%: Intro pop-in (Maintains the fast 0.8s entrance speed) */
            0% {
                opacity: 0;
                transform: scale(0) rotate(25deg) translateX(50px);
            }
            4.8% {
                transform: scale(1.08) rotate(-5deg) translateX(-5px);
            }
            6.6% {
                opacity: 0.93;
                transform: scale(1) rotate(0deg) translateX(0);
            }

            /* 6.6% to 83.3%: Stay perfectly still on screen while shining (Exactly 10 seconds hold) */
            83.3% {
                opacity: 0.93;
                transform: scale(1) rotate(0deg) translateX(0);
            }

            /* 83.3% to 91.6%: Disappearing movement (Stretching/shifting away like letters collapsing) */
            86.5% {
                opacity: 0.7;
                transform: scale(0.9, 1.05) rotate(-3deg) translateX(-15px);
            }
            91.6% {
                opacity: 0;
                transform: scale(0) rotate(15deg) translateX(40px);
            }

            /* 91.6% to 100%: Hidden rest period before restarting the loop (1 second) */
            100% {
                opacity: 0;
                transform: scale(0) rotate(25deg) translateX(50px);
            }
        }

        /* Sweeps beautifully from Right to Left (Untouched) */
        @keyframes logoShineRTL {
            0% {
                right: -150%;
            }
            100% {
                right: 150%;
            }
        }
    </style>
</head>
<body>

    <div id="logo-container">
        <div class="bug-wrapper">
            <img src="https://raw.githubusercontent.com/Mastergive/randompngtosave/refs/heads/main/Stoon3D.png" alt="Spacetoon Logo" class="bug-image">
        </div>
    </div>

    <script>
        const container = document.getElementById('logo-container');
        const wrapper = document.querySelector('.bug-wrapper');

        function startScreenbug() {
            // Instantly start the background shine loop
            wrapper.classList.add('shine-active');
            
            // Trigger the 12-second master visibility sequence loop
            container.classList.add('looping-active');
        }

        function stopScreenbug() {
            container.classList.remove('looping-active');
            wrapper.classList.remove('shine-active');
        }

        // Initialize when page loads
        window.addEventListener('DOMContentLoaded', () => {
            startScreenbug();
        });

        /* OBS Browser Source Visibility Hooks */
        window.addEventListener('obsSourceVisibleChanged', function(event) {
            if (event.detail.visible) {
                startScreenbug();
            } else {
                stopScreenbug();
            }
        });
    </script>
</body>
</html>
